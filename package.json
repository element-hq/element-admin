{
  "name": "element-admin",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-hq/element-admin.git"
  },
  "bugs": {
    "url": "https://github.com/element-hq/element-admin/issues"
  },
  "license": "SEE LICENSE IN README.md",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "oxlint && stylelint 'src/**/*.css' && oxfmt --check",
    "fix": "oxlint --fix && stylelint --fix 'src/**/*.css' && oxfmt",
    "i18n:extract": "formatjs extract --throws --format crowdin 'src/**/*.{ts,tsx}' --out-file translations/extracted/en.json && oxfmt translations/extracted/en.json",
    "i18n:download": "localazy download && oxfmt translations/translated/",
    "i18n:compile": "formatjs compile-folder --format crowdin --ast translations/translated/ translations/compiled/ && oxfmt translations/compiled",
    "openapi-ts": "openapi-ts",
    "prepare": "husky",
    "browserslist": "browserslist",
    "test": "playwright test"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@fontsource/inconsolata": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@formatjs/intl-localematcher": "0.8.2",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/query-persist-client-core": "5.95.2",
    "@tanstack/react-pacer": "0.20.0",
    "@tanstack/react-query": "5.95.2",
    "@tanstack/react-router": "1.167.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.23",
    "@vector-im/compound-design-tokens": "7.0.0",
    "@vector-im/compound-web": "8.4.0",
    "classnames": "2.5.1",
    "idb-keyval": "6.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "6.1.1",
    "react-hot-toast": "2.6.0",
    "react-intl": "10.0.0",
    "semver": "7.7.4",
    "use-broadcast-ts": "2.0.1",
    "valibot": "1.3.0",
    "vaul": "1.1.2",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@formatjs/cli": "6.13.3",
    "@formatjs/unplugin": "1.1.0",
    "@hey-api/openapi-ts": "0.94.2",
    "@localazy/cli": "2.0.8",
    "@playwright/test": "1.58.2",
    "@rolldown/plugin-babel": "0.2.1",
    "@tailwindcss/vite": "4.2.1",
    "@tanstack/devtools-vite": "0.6.0",
    "@tanstack/eslint-plugin-query": "5.95.2",
    "@tanstack/eslint-plugin-router": "1.161.6",
    "@tanstack/react-devtools": "0.10.0",
    "@tanstack/react-pacer-devtools": "0.5.4",
    "@tanstack/react-query-devtools": "5.95.2",
    "@tanstack/react-router-devtools": "1.166.9",
    "@tanstack/router-plugin": "1.166.13",
    "@tsconfig/strictest": "2.0.8",
    "@tsconfig/vite-react": "7.0.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.28.1",
    "eslint-plugin-formatjs": "6.4.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "9.1.7",
    "knip": "5.88.1",
    "lint-staged": "16.4.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "oxlint-tsgolint": "0.17.0",
    "stylelint": "17.4.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt"
    ],
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "knip": {
    "entry": [
      "src/base.css",
      "src/prerender.tsx"
    ],
    "ignoreDependencies": [
      "@tanstack/eslint-plugin-query",
      "@tanstack/eslint-plugin-router",
      "eslint-plugin-formatjs",
      "eslint-plugin-react-hooks"
    ],
    "ignore": [
      "src/api/mas/api/**/*",
      "src/api/synapse.ts"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
