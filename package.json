{
  "name": "element-admin",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-hq/element-admin.git"
  },
  "bugs": {
    "url": "https://github.com/element-hq/element-admin/issues"
  },
  "license": "SEE LICENSE IN README.md",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "oxlint && stylelint 'src/**/*.css' && oxfmt --check",
    "fix": "oxlint --fix && stylelint --fix 'src/**/*.css' && oxfmt",
    "i18n:extract": "formatjs extract --throws --format crowdin 'src/**/*.{ts,tsx}' --out-file translations/extracted/en.json && oxfmt translations/extracted/en.json",
    "i18n:download": "localazy download && oxfmt translations/translated/",
    "i18n:compile": "formatjs compile-folder --format crowdin --ast translations/translated/ translations/compiled/ && oxfmt translations/compiled",
    "openapi-ts": "openapi-ts",
    "prepare": "husky",
    "browserslist": "browserslist",
    "test": "playwright test"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@fontsource/inconsolata": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@formatjs/intl-localematcher": "0.8.8",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/query-persist-client-core": "5.100.11",
    "@tanstack/react-pacer": "0.22.1",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-router": "1.170.6",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.25",
    "@vector-im/compound-design-tokens": "10.1.1",
    "@vector-im/compound-web": "9.3.0",
    "classnames": "2.5.1",
    "idb-keyval": "6.2.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-error-boundary": "6.1.1",
    "react-hot-toast": "2.6.0",
    "react-intl": "10.1.8",
    "semver": "7.8.0",
    "use-broadcast-ts": "2.0.1",
    "valibot": "1.4.0",
    "vaul": "1.1.2",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@formatjs/cli": "6.16.1",
    "@formatjs/unplugin": "1.1.13",
    "@hey-api/openapi-ts": "0.97.2",
    "@localazy/cli": "2.0.10",
    "@playwright/test": "1.60.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/eslint-plugin-query": "5.100.11",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-pacer-devtools": "0.7.1",
    "@tanstack/react-query-devtools": "5.100.11",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.9",
    "@tsconfig/strictest": "2.0.8",
    "@tsconfig/vite-react": "8.0.6",
    "@types/babel__core": "7.20.5",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.28.2",
    "eslint-plugin-formatjs": "6.4.10",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "knip": "6.14.1",
    "lint-staged": "17.0.5",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.23.0",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  },
  "lint-staged": {
    "*": [
      "oxfmt"
    ],
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "knip": {
    "entry": [
      "src/base.css",
      "src/prerender.tsx"
    ],
    "ignore": [
      "src/api/mas/api/**/*",
      "src/api/synapse.ts"
    ]
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
