{
  "name": "element-admin",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/element-hq/element-admin.git"
  },
  "bugs": {
    "url": "https://github.com/element-hq/element-admin/issues"
  },
  "license": "SEE LICENSE IN README.md",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "knip": "knip && knip --production",
    "lint": "oxlint && stylelint 'src/**/*.css' && oxfmt --check",
    "fix": "oxlint --fix && stylelint --fix 'src/**/*.css' && oxfmt",
    "i18n:extract": "formatjs extract --throws --format crowdin 'src/**/*.{ts,tsx}' --out-file translations/extracted/en.json && oxfmt translations/extracted/en.json",
    "i18n:download": "localazy download && pnpm i18n:normalize && oxfmt translations/translated/",
    "i18n:normalize": "node scripts/i18n-normalize-plurals.mjs",
    "i18n:compile": "pnpm i18n:normalize && formatjs compile-folder --format crowdin --ast translations/translated/ translations/compiled/ && oxfmt translations/compiled",
    "openapi-ts": "openapi-ts",
    "prepare": "husky",
    "browserslist": "browserslist",
    "test": "playwright test"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@fontsource/inconsolata": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@formatjs/intl-localematcher": "0.8.13",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/query-persist-client-core": "5.101.4",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.19",
    "@tanstack/react-table": "9.0.0",
    "@tanstack/react-virtual": "3.14.9",
    "@vector-im/compound-design-tokens": "10.2.3",
    "@vector-im/compound-web": "9.9.0",
    "classnames": "2.5.1",
    "idb-keyval": "6.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.2",
    "react-hot-toast": "2.6.0",
    "react-intl": "10.1.20",
    "use-broadcast-ts": "2.0.1",
    "valibot": "1.4.2",
    "vaul": "1.1.2",
    "verkit": "^0.3.2",
    "woothee": "1.11.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@formatjs/cli": "6.16.16",
    "@formatjs/icu-messageformat-parser": "3.5.16",
    "@formatjs/unplugin": "1.2.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@localazy/cli": "2.0.12",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-pacer-devtools": "0.8.0",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.24",
    "@tsconfig/strictest": "2.0.8",
    "@tsconfig/vite-react": "8.1.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/woothee": "1.11.3",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.28.7",
    "eslint-plugin-formatjs": "6.4.20",
    "husky": "9.1.7",
    "knip": "6.31.0",
    "lint-staged": "17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt"
    ],
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "knip": {
    "entry": [
      "src/base.css!",
      "src/prerender.tsx!"
    ],
    "project": [
      "src/**/*!"
    ],
    "ignore": [
      "src/api/mas/api/**/*",
      "src/api/synapse.ts"
    ]
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
